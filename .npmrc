# Expo SDK 57 est à cheval sur deux systèmes de numérotation : expo-router 57.x réclame
# expo-constants ^57, alors que le SDK livre encore expo-constants 18.x. npm refuse donc
# d'installer sans ce réglage, et un `npm install` nu échoue pour qui clone le projet.
# Les versions installées sont celles testées ; ce fichier évite d'avoir à retenir un flag.
legacy-peer-deps=true
