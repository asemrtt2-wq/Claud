# Database (PostgreSQL — e.g. Vercel Postgres or Neon, both have free tiers)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth (admin login)
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Seeded admin account (used by prisma/seed.ts)
ADMIN_EMAIL="admin@fitbookpro.com"
ADMIN_PASSWORD="change-me-before-seeding"

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
