generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EBook {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String
  description String
  content     String   @default("")
  category    String
  author      String   @default("")
  publishedYear Int?
  audience    String   @default("adults")
  coverEmoji  String
  coverTheme  String
  price       Float
  oldPrice    Float?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
  favorites   Favorite[]
  progress    ReadingProgress[]
  collectionItems CollectionItem[]
}

model Order {
  id                    String    @id @default(cuid())
  ebookId               String
  ebook                 EBook     @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  customerId            String?
  customer              Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerEmail         String
  amount                Float
  status                String    @default("pending")
  stripeSessionId       String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Admin {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}

model Customer {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  createdAt    DateTime      @default(now())
  orders       Order[]
  subscription Subscription?
  profiles     Profile[]
}

model Profile {
  id                String   @id @default(cuid())
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name              String
  avatarEmoji       String   @default("🙂")
  color             String   @default("purple")
  type              String   @default("adult")
  pinHash           String?
  dailyLimitMinutes Int?
  minutesReadToday  Int      @default(0)
  limitResetDate    String?
  reminderTime      String?
  monthlyBookGoal   Int?
  totalMinutesRead  Int      @default(0)
  readingStreak     Int      @default(0)
  lastReadDate      String?
  createdAt         DateTime @default(now())

  favorites   Favorite[]
  progress    ReadingProgress[]
  collections Collection[]
}

model Collection {
  id         String           @id @default(cuid())
  profileId  String
  profile    Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime         @default(now())
  items      CollectionItem[]
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  ebookId      String
  ebook        EBook      @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@unique([collectionId, ebookId])
}

model Subscription {
  id                   String    @id @default(cuid())
  customerId           String    @unique
  customer             Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan                 String
  status               String    @default("incomplete")
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Favorite {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ebookId   String
  ebook     EBook    @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([profileId, ebookId])
}

model ReadingProgress {
  id                String    @id @default(cuid())
  profileId         String
  profile           Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ebookId           String
  ebook             EBook     @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  page              Int       @default(0)
  completed         Boolean   @default(false)
  lastPageAt        DateTime?
  avgSecondsPerPage Float?
  updatedAt         DateTime  @updatedAt

  @@unique([profileId, ebookId])
}
